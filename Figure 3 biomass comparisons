# ── SERIES DEL MODELO BASE ───────────────────────────────────────────────────
ts_A <- mb$timeseries %>%
  filter(Yr >= 1950, Seas == 1) %>%
  mutate(Bio_all_t = Bio_all/1000, SSB_t = SpawnBio/1000,
         Catch_t = rowSums(select(., starts_with("dead(B)")), na.rm = TRUE)/1000)

# sex ratio del MISMO modelo (transición sexual activa)
sxcols <- grep("SmryNum_SX:", names(mb$timeseries), value = TRUE)
stopifnot(length(sxcols) >= 2)
ts_D <- mb$timeseries %>%
  filter(Yr >= 1950, Seas == 1) %>%
  mutate(sex_ratio = .data[[sxcols[1]]] / (.data[[sxcols[1]]] + .data[[sxcols[2]]]) * 100)

sr_unfished <- ts_D$sex_ratio[which.min(ts_D$Yr)]
pk       <- ts_D %>% filter(Yr >= 1990, Yr <= 2015) %>% slice_max(sex_ratio, n = 1)
sr_peak  <- pk$sex_ratio; yr_peak <- pk$Yr
sr_last  <- ts_D$sex_ratio[ts_D$Yr == EY]
delta_pp <- round(sr_peak - sr_unfished, 1)
cat(sprintf("Sex ratio — unfished: %.1f%% | peak: %.1f%% (%d) | %d: %.1f%%\n",
            sr_unfished, sr_peak, yr_peak, EY, sr_last))

