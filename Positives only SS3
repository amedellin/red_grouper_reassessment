# ============================================================
# ETAPA 1 — índice de solo positivos
# ------------------------------------------------------------
# Idéntico a idx_fleet salvo por filter(pos == 1) antes del ajuste: al no
# haber ceros, el componente binomial del delta-lognormal desaparece y solo
# queda el lognormal sobre capturas positivas.
# ============================================================
idx_pos <- function(f, min_trips = 20) {
  d <- defs[[DEF]] %>%
    filter(fleet == f, !buceo, !is.na(nves), Yr != 2001, Yr >= YR0[[f]],
           ton_mor > 0) %>%                       # <-- solo positivos
    mutate(Sitef = factor(ifelse(Site %in% c("El Cuyo","Rio Lagartos",
                                             "San Felipe","Not specified"),
                                 "other", Site)),
           uef = factor(if (f == "mid.range") ves else ue),
           Yrf = factor(Yr), mesf = factor(mes), lc = log(cpue))
  keep <- names(which(table(d$uef) >= min_trips))
  d <- d %>% filter(uef %in% keep) %>%
    mutate(across(c(Yrf, mesf, Sitef, uef), droplevels))
  
  gp <- lmer(lc ~ Yrf + mesf + Sitef + (1|uef), data = d, REML = FALSE)
  md <- function(v) factor(names(sort(table(d[[v]]), decreasing = TRUE))[1],
                           levels = levels(d[[v]]))
  nd <- data.frame(Yrf = levels(d$Yrf), mesf = md("mesf"), Sitef = md("Sitef"))
  ix <- exp(predict(gp, nd, re.form = NA))
  data.frame(Yr = as.numeric(levels(d$Yrf)), index = ix/mean(ix),
             se_log = SE[[f]], fleet = f, n = as.numeric(table(d$Yrf)))
}

posF2 <- idx_pos("mid.range"); posF1 <- idx_pos("artisanal")
pos   <- rbind(posF1, posF2)

cat("=== índice de solo positivos ===\n")
for (f in unique(pos$fleet)) {
