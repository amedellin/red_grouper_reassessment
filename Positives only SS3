library(r4ss); library(parallel); library(dplyr)

ROOT  <- dirname(base_dir)
BASE  <- file.path(ROOT, "positives_only")  # configuración base + positivos
NJIT  <- 30
JFRAC <- 0.10
NCORE <- max(1, min(detectCores() - 1, 8))
TOL   <- 1e-3
BOUND_TOL <- 0.005
SCALE <- c(0.2, 5)

inputs_of <- function(d) {
  f <- list.files(d, full.names = TRUE, include.dirs = FALSE)
  f[!grepl("Report\\.sso|CompReport|covar\\.sso|ss3\\.par_[0-9]+\\.sso$|\\.ss_new$|\\.ss_old$|echoinput|warning",
           basename(f), ignore.case = TRUE)]
}
at_bound <- function(o) {
  p <- o$parameters %>% filter(!is.na(Phase), Phase > 0, !is.na(Min), !is.na(Max))
  if (!nrow(p)) return(character(0))
  r <- p$Max - p$Min
  p$Label[(abs(p$Value-p$Min)/r < BOUND_TOL) | (abs(p$Value-p$Max)/r < BOUND_TOL)]
}
grab <- function(d, rep = NA) {
  o <- tryCatch(SS_output(d, verbose = FALSE, printstats = FALSE, covar = FALSE),
                error = function(e) NULL)
  if (is.null(o)) return(data.frame(rep = rep, logL = NA))
  ey <- o$endyr; dq <- o$derived_quants; lu <- o$likelihoods_used
  gv <- function(x) if (x %in% rownames(lu)) lu[x,"values"] else NA
  b <- at_bound(o)
  data.frame(rep = rep, logL = gv("TOTAL"), grad = o$maximum_gradient_component,
             Survey = gv("Survey"), Len = gv("Length_comp"),
             R0 = o$parameters["SR_LN(R0)","Value"],
             B0 = dq["SSB_unfished","Value"],
             SSB = dq[paste0("SSB_", ey-1),"Value"],
             B_Bmsy = dq[paste0("Bratio_",ey),"Value"]/dq["B_MSY/SSB_unfished","Value"],
             F_Fmsy = dq[paste0("F_",ey),"Value"],
             SPR = 1 - dq[paste0("SPRratio_",ey),"Value"],
             MSY = dq["Dead_Catch_MSY","Value"],
             OFL = dq[paste0("OFLCatch_", ey+1),"Value"],
             n_bound = length(b), bounds = paste(b, collapse = "; "),
             stringsAsFactors = FALSE)
}

stopifnot(dir.exists(BASE))
ref <- grab(BASE)
cat(sprintf("referencia: logL %.3f | grad %.1e | R0 %.3f | B0 %.0f | B/Bmsy %.3f | límites %d\n",
            ref$logL, ref$grad, ref$R0, ref$B0, ref$B_Bmsy, ref$n_bound))
if (ref$n_bound > 0) cat("  en límite:", ref$bounds, "\n")
B0ref <- ref$B0

jr <- file.path(ROOT, "jit_R6_index_real")
unlink(jr, recursive = TRUE); dir.create(jr)
dirs <- file.path(jr, sprintf("r%02d", 1:NJIT))
for (i in seq_along(dirs)) {
  dir.create(dirs[i]); file.copy(inputs_of(BASE), dirs[i], overwrite = TRUE)
  s <- SS_readstarter(file.path(dirs[i], "starter.ss"), verbose = FALSE)
  s$jitter_fraction <- JFRAC; s$init_values_src <- 0; s$seed <- i*1000
  SS_writestarter(s, dirs[i], overwrite = TRUE, verbose = FALSE)
}
cl <- makeCluster(NCORE); clusterExport(cl, "dirs", envir = environment())
invisible(parLapply(cl, dirs, function(d)
  try(r4ss::run(dir=d, exe="ss3", skipfinished=FALSE, show_in_console=FALSE), silent=TRUE)))
stopCluster(cl)

jt <- bind_rows(lapply(seq_along(dirs), function(i) grab(dirs[i], i))) %>%
  mutate(valido = !is.na(logL) & grad < TOL & n_bound == 0 &
           B0 > SCALE[1]*B0ref & B0 < SCALE[2]*B0ref)

cat(sprintf("\nconvergidas %d | sin límites %d | escala OK %d | VÁLIDAS %d de %d\n",
            sum(jt$grad < TOL, na.rm=TRUE), sum(jt$n_bound == 0, na.rm=TRUE),
            sum(jt$B0 > SCALE[1]*B0ref & jt$B0 < SCALE[2]*B0ref, na.rm=TRUE),
            sum(jt$valido, na.rm=TRUE), NJIT))
if (any(jt$n_bound > 0, na.rm=TRUE))
  cat("  parámetros en límite:",
      paste(unique(jt$bounds[jt$n_bound > 0 & nzchar(jt$bounds)]), collapse=" | "), "\n")

v <- jt %>% filter(valido) %>% arrange(logL)
if (nrow(v)) {
  cat("\n--- 6 mejores ---\n")
  print(as.data.frame(v %>% select(rep, logL, grad, R0, B0, SSB, B_Bmsy, F_Fmsy, SPR, MSY, OFL) %>%
                        head(6)), digits = 4, row.names = FALSE)
  cat(sprintf("\nMEJOR: logL %.3f (rep %d) | referencia %.3f | mejora %.3f\n",
              v$logL[1], v$rep[1], ref$logL, ref$logL - v$logL[1]))
  cat("\n=== VALORES PARA EL MANUSCRITO ===\n")
  cat(sprintf("  B/Bmsy  %.3f   [%.3f - %.3f]   %.0f%% bajo BMSY\n",
              v$B_Bmsy[1], min(v$B_Bmsy), max(v$B_Bmsy), 100*mean(v$B_Bmsy < 1)))
  cat(sprintf("  F/Fmsy  %.3f   [%.3f - %.3f]   %.0f%% con sobrepesca\n",
              v$F_Fmsy[1], min(v$F_Fmsy), max(v$F_Fmsy), 100*mean(v$F_Fmsy > 1)))
  cat(sprintf("  SPR     %.3f   [%.3f - %.3f]\n", v$SPR[1], min(v$SPR), max(v$SPR)))
  cat(sprintf("  B0      %.0f  [%.0f - %.0f] t\n", v$B0[1], min(v$B0), max(v$B0)))
  cat(sprintf("  SSB     %.0f  t\n", v$SSB[1]))
  cat(sprintf("  MSY     %.0f  [%.0f - %.0f] t\n", v$MSY[1], min(v$MSY), max(v$MSY)))
  cat(sprintf("  OFL     %.0f  [%.0f - %.0f] t\n", v$OFL[1], min(v$OFL), max(v$OFL)))
  BEST <- dirs[v$rep[1]]
} else { cat("!! ninguna réplica válida\n"); BEST <- BASE }

cat("\nmejor réplica:", BEST, "\n")
cat("\nSIGUIENTE: retrospectivo sobre esta réplica. El perfil de R0 ya se corrió\n")
cat("sobre la referencia (mínimo 10.25, IC hasta 10.50, B0 varía 28% dentro del IC).\n")
write.csv(jt, file.path(ROOT, "jitter_positives_only.csv"), row.names = FALSE)
