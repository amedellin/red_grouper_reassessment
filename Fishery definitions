# ------------------------------------------------------------
# Defining the red grouper fishery, and recovering true zeros
# ------------------------------------------------------------
# The database covers ALL fisheries (octopus, tuna...), so "every trip
# without grouper" is NOT a zero. A zero is a trip that plausibly fished
# the grouper grounds with the grouper gear and landed none.
#
# Strategy: use grouper trips to derive the co-occurring species assemblage
# empirically, then treat mid-range trips landing that assemblage but no
# grouper as genuine zeros. Sensitivity to the definition is reported,
# because the definition is a judgement call and must be shown to be one.
# -------------------------------------------------------------

library(dplyr); library(ggplot2)

MORIO <- "Epinephelus morio"
FLEET <- "mid.range"          # "artisanal" for F1

yuc <- yucatan %>%
  mutate(trip = paste(FOLIO.AVISO, ANO.CORTE, mes, dia, RNP.ACTIVO))

trips_mero <- unique(yuc$trip[yuc$species == MORIO])
cat("Viajes con mero:", length(trips_mero),
    "| viajes totales en la base:", n_distinct(yuc$trip), "\n\n")

# ============================================================
# A. What actually co-occurs with grouper (your rgfishery, quantified)
# ============================================================
perfil <- yuc %>% filter(trip %in% trips_mero, species != MORIO) %>%
  group_by(species, species.a) %>%
  summarise(n_trips = n_distinct(trip), .groups = "drop") %>%
  mutate(pct = 100 * n_trips / length(trips_mero)) %>%
  arrange(desc(pct))
cat("=== Especies acompañantes del mero (% de viajes con mero) ===\n")
print(as.data.frame(head(perfil, 15)) %>% mutate(pct = round(pct, 1)))

UMBRAL   <- 10                                     # % de viajes con mero
sp_assoc <- perfil$species[perfil$pct >= UMBRAL]
cat("\nEnsamblaje (>=", UMBRAL, "% de viajes con mero):\n")
cat(paste(" -", sp_assoc), sep = "\n")

# ============================================================
# B. Three fishery definitions -> three zero rates
# ============================================================
tripdat <- yuc %>% filter(fleet == FLEET) %>%
  group_by(trip) %>%
  summarise(Yr = first(ANO.CORTE), mes = first(mes), vessel = first(RNP.ACTIVO),
            Site = first(Site), nves = max(NUMERO.EMBARCACIONES, na.rm = TRUE),
            ton_mero  = sum(ton[species == MORIO], na.rm = TRUE),
            has_mero  = any(species == MORIO),
            has_assoc = any(species %in% sp_assoc),
            has_targ  = any(species.a %in% c("01-target", "02-associated")),
            .groups = "drop")

# vessels that genuinely participate in the fishery (>=20% of their trips)
vess_mero <- tripdat %>% group_by(vessel) %>%
  summarise(p = mean(has_mero), n = n(), .groups = "drop") %>%
  filter(p >= 0.20, n >= 10) %>% pull(vessel)

defs <- list(
  A_solo_positivos = tripdat %>% filter(has_mero),
  B_ensamblaje     = tripdat %>% filter(has_mero | has_assoc),
  C_clasificacion  = tripdat %>% filter(has_mero | has_targ),
  D_embarcaciones  = tripdat %>% filter(vessel %in% vess_mero))

cat("\n=== Sensibilidad a la definición de pesquería ===\n")
for (nm in names(defs)) {
  x <- defs[[nm]]
  cat(sprintf("%-18s viajes %6d | %% ceros %5.1f\n", nm, nrow(x),
              100 * mean(!x$has_mero)))
}

# ============================================================
# C. THE DECISIVE DIAGNOSTIC — zero rate and CPUE through time
# ============================================================
serie <- function(x, lab) {
  x %>% mutate(cpue = ton_mero / (pmax(nves, 1) * 1500) * 100) %>%
    group_by(Yr) %>%
    summarise(n = n(), pct_cero = 100 * mean(ton_mero == 0),
              cpue = mean(cpue), .groups = "drop") %>%
    mutate(def = lab)
}
tab <- bind_rows(lapply(names(defs), function(n) serie(defs[[n]], n)))

cat("\n=== Tasa de ceros por año (¿sube?) ===\n")
print(tidyr::pivot_wider(tab %>% select(Yr, def, pct_cero),
                         names_from = def, values_from = pct_cero) %>%
        as.data.frame() %>% mutate(across(where(is.numeric), ~round(., 1))))

cat("\n=== Tendencia de cada serie ===\n")
print(tab %>% group_by(def) %>%
        summarise(pend_cpue = coef(lm(cpue ~ Yr))[2],
                  p_cpue    = summary(lm(cpue ~ Yr))$coefficients[2, 4],
                  pend_cero = coef(lm(pct_cero ~ Yr))[2], .groups = "drop") %>%
        mutate(across(where(is.numeric), ~signif(., 3))) %>% as.data.frame())

p <- ggplot(tab, aes(Yr, cpue / ave(cpue, def, FUN = mean), colour = def)) +
  geom_line(linewidth = 0.9) + geom_point(size = 1.1) +
  geom_hline(yintercept = 1, linetype = "dotted") +
  labs(title = "CPUE de mero según la definición de pesquería",
       subtitle = "A = solo positivos (índice actual). B/C/D reconstruyen ceros.",
       x = "Año", y = "Índice relativo") +
  theme_bw(base_size = 12) + theme(legend.position = "bottom")
ggsave("F2_cpue_definiciones.png", p, width = 9.5, height = 5.5, dpi = 300)

cat("\nLECTURA: si 'pct_cero' SUBE con los años, la proporción de viajes de la\n",
    "pesquería que encuentran mero está cayendo — señal de abundancia que el\n",
    "índice de solo-positivos no puede ver. Y si la tendencia de A es positiva\n",
    "mientras B/C/D son planas o negativas, la recuperación es artefacto de\n",
    "excluir los ceros.\n")

