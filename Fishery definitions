# ============================================================
# Control interno E. morio / M. bonaci — por flota y sitio de desembarque
# ------------------------------------------------------------
# Restringe a viajes que SÍ capturaron mero del género (bonaci presente):
# mismo arte, mismos fondos, mismo esfuerzo, misma economía. La sustitución
# a pulpo no puede explicar una caída aquí.
#
# CUIDADO al estratificar:
#  - n por celda cae mucho -> se exigen mínimos explícitos
#  - muchas combinaciones flota x sitio -> p-valores corregidos (BH)
#  - anzuelos imputados difieren por flota (1500 vs 150)
# ============================================================

library(dplyr)

MORIO <- "Epinephelus morio"
MB    <- "Mycteroperca bonaci"
DROP  <- c(2002)          # Isidoro: esfuerzo casi nulo
MIN_TRIPS_YR <- 10        # viajes con bonaci por año para conservar ese año
MIN_YEARS    <- 8         # años necesarios para ajustar tendencia
HOOKS <- c("mid.range" = 500, "artisanal" = 262)   # medianas de permisos   # <- VERIFICA las etiquetas

cat("=== etiquetas de flota en la base ===\n"); print(table(yuc$fleet))
cat("\n=== sitios (top 15) ===\n"); print(head(sort(table(yuc$Site), decreasing = TRUE), 15))

# ---- tabla a nivel de viaje ----
trips <- yuc %>%
  group_by(trip) %>%
  summarise(fleet = first(fleet), Site = first(Site), Yr = first(ANO.CORTE),
            nves   = max(NUMERO.EMBARCACIONES, na.rm = TRUE),
            bonaci = any(species == MB),
            morio  = any(species == MORIO),
            ton_morio  = sum(ton[species == MORIO], na.rm = TRUE),
            ton_bonaci = sum(ton[species == MB],    na.rm = TRUE),
            .groups = "drop") %>%
  filter(bonaci, !Yr %in% DROP) %>%
  mutate(hooks = unname(HOOKS[as.character(fleet)]))

cat("\nViajes con bonaci:", nrow(trips),
    "| sin anzuelos asignados:", sum(is.na(trips$hooks)), "\n")

# ---- serie anual por estrato ----
serie <- function(d, keys) {
  d %>% group_by(across(all_of(keys)), Yr) %>%
    summarise(n_viajes      = n(),
              pct_con_morio = 100 * mean(morio),
              cpue_morio    = mean(ton_morio / (pmax(nves, 1) * hooks) * 100),
              ratio_mor_bon = sum(ton_morio) / sum(ton_bonaci),
              .groups = "drop")
}

fit_tend <- function(d) {
  out <- data.frame(n_anios = nrow(d), n_viajes = sum(d$n_viajes))
  for (v in c("pct_con_morio", "cpue_morio", "ratio_mor_bon")) {
    ok <- is.finite(d[[v]])
    if (sum(ok) >= MIN_YEARS) {
      m <- lm(d[[v]][ok] ~ d$Yr[ok]); s <- summary(m)$coefficients
      out[[paste0(v, "_pend")]] <- s[2, 1]
      out[[paste0(v, "_p")]]    <- s[2, 4]
    } else { out[[paste0(v, "_pend")]] <- NA; out[[paste0(v, "_p")]] <- NA }
  }
  out
}

# ============================================================
# A. Por FLOTA (agregado sobre sitios)
# ============================================================
sf <- serie(trips, "fleet")
cat("\n===== SERIE POR FLOTA =====\n")
print(as.data.frame(sf), digits = 4)

res_f <- sf %>% filter(n_viajes >= MIN_TRIPS_YR) %>%
  group_by(fleet) %>% group_modify(~fit_tend(.x)) %>% ungroup()
cat("\n===== TENDENCIAS POR FLOTA =====\n")
print(as.data.frame(res_f), digits = 3)

# ============================================================
# B. Por FLOTA x SITIO
# ============================================================
ss <- serie(trips, c("fleet", "Site"))
res_s <- ss %>% filter(n_viajes >= MIN_TRIPS_YR) %>%
  group_by(fleet, Site) %>% group_modify(~fit_tend(.x)) %>% ungroup() %>%
  filter(n_anios >= MIN_YEARS)

# corrección por comparaciones múltiples (Benjamini-Hochberg)
for (v in c("pct_con_morio", "cpue_morio", "ratio_mor_bon")) {
  pcol <- paste0(v, "_p")
  res_s[[paste0(v, "_padj")]] <- p.adjust(res_s[[pcol]], method = "BH")
}

cat("\n===== TENDENCIAS POR FLOTA x SITIO =====\n")
cat("(padj = p corregido por comparaciones múltiples, BH)\n\n")
print(as.data.frame(
  res_s %>% arrange(fleet, ratio_mor_bon_pend) %>%
    select(fleet, Site, n_anios, n_viajes,
           ratio_pend = ratio_mor_bon_pend, ratio_p = ratio_mor_bon_p,
           ratio_padj = ratio_mor_bon_padj,
           pct_pend = pct_con_morio_pend, pct_padj = pct_con_morio_padj)),
  digits = 3)

cat("\n--- resumen del control interno (ratio E. morio / M. bonaci) ---\n")
cat("  estratos evaluados      :", nrow(res_s), "\n")
cat("  pendiente negativa      :", sum(res_s$ratio_mor_bon_pend < 0, na.rm = TRUE), "\n")
cat("  negativa y padj < 0.05  :", sum(res_s$ratio_mor_bon_pend < 0 &
                                         res_s$ratio_mor_bon_padj < 0.05, na.rm = TRUE), "\n")
cat("  positiva y padj < 0.05  :", sum(res_s$ratio_mor_bon_pend > 0 &
                                         res_s$ratio_mor_bon_padj < 0.05, na.rm = TRUE), "\n")
cat("\nLECTURA: lo informativo es la CONSISTENCIA entre sitios independientes,\n",
    "no que alguno alcance significancia. Si la mayoría de estratos con datos\n",
    "suficientes muestran pendiente negativa, la señal es de abundancia.\n")

write.csv(res_s, "bonaci_tendencias_flota_sitio.csv", row.names = FALSE)

#--------------------------------------------------------------
# the negrillo-boquinete test
# Contaminación por arte en el control interno E. morio / M. bonaci
# ------------------------------------------------------------
# L. maximus (boquinete) se captura con arpón/buceo, no con anzuelo.
# Si un aviso registra boquinete, ese viaje pudo operar con buceo — arte
# con selectividad completamente distinta (el buzo VE y ELIGE; el anzuelo no).
#
# RIESGO PRINCIPAL: si la proporción de viajes con buceo cambió en el tiempo,
# eso por sí solo genera tendencia en el ratio sin cambio de abundancia.
# ============================================================

library(dplyr)

MORIO <- "Epinephelus morio"
MB    <- "Mycteroperca bonaci"
BUCEO <- c("Lachnolaimus maximus")                 # amplía si aplica
OTRO  <- c("Octopus maya")                          # jimba, tampoco anzuelo
DROP  <- c(2002)

tb <- yuc %>%
  group_by(trip) %>%
  summarise(fleet = first(fleet), Site = first(Site), Yr = first(ANO.CORTE),
            bonaci = any(species == MB),
            morio  = any(species == MORIO),
            buceo  = any(species %in% BUCEO),
            pulpo  = any(species %in% OTRO),
            n_spp  = n_distinct(species),
            ton_morio  = sum(ton[species == MORIO], na.rm = TRUE),
            ton_bonaci = sum(ton[species == MB],    na.rm = TRUE),
            .groups = "drop") %>%
  filter(bonaci, !Yr %in% DROP)

cat("Viajes con bonaci:", nrow(tb),
    "| con boquinete:", sum(tb$buceo), sprintf("(%.1f%%)", 100*mean(tb$buceo)),
    "| con pulpo:", sum(tb$pulpo), sprintf("(%.1f%%)", 100*mean(tb$pulpo)), "\n\n")

# ============================================================
# A. ¿Cambia con el tiempo la proporción de viajes con buceo?
#    (si sí, puede generar tendencia espuria por sí sola)
# ============================================================
prop <- tb %>% group_by(fleet, Yr) %>%
  summarise(n = n(), pct_buceo = 100*mean(buceo), pct_pulpo = 100*mean(pulpo),
            .groups = "drop")
cat("=== % de viajes con bonaci que además traen boquinete ===\n")
print(as.data.frame(tidyr::pivot_wider(prop %>% select(fleet, Yr, pct_buceo),
                                       names_from = fleet, values_from = pct_buceo)),
      digits = 3)
cat("\ntendencia de la contaminación:\n")
for (f in unique(prop$fleet)) {
  s <- prop[prop$fleet == f, ]
  if (nrow(s) >= 8) {
    m <- lm(pct_buceo ~ Yr, data = s); co <- summary(m)$coefficients
    cat(sprintf("  %-11s pendiente %+7.3f pp/año  p = %.3g\n", f, co[2,1], co[2,4]))
  }
}
cat("  --> si la pendiente es significativa, la mezcla de artes cambia y\n",
    "      PUEDE explicar parte de la tendencia del ratio.\n")

# ============================================================
# B. El ratio, con y sin viajes de buceo
# ============================================================
serie <- function(d, lab) {
  d %>% group_by(fleet, Yr) %>%
    summarise(n = n(), pct_con_morio = 100*mean(morio),
              ratio = sum(ton_morio)/sum(ton_bonaci), .groups = "drop") %>%
    mutate(estrato = lab)
}
s_all <- serie(tb,                    "todos")
s_sin <- serie(tb %>% filter(!buceo), "sin boquinete")
s_con <- serie(tb %>% filter( buceo), "solo boquinete")
todo  <- bind_rows(s_all, s_sin, s_con)

cat("\n=== TENDENCIA DEL RATIO por estrato ===\n")
for (f in unique(todo$fleet)) for (e in unique(todo$estrato)) {
  s <- todo[todo$fleet == f & todo$estrato == e & is.finite(todo$ratio), ]
  if (nrow(s) >= 8) {
    m <- lm(ratio ~ Yr, data = s); co <- summary(m)$coefficients
    cat(sprintf("  %-11s %-15s n_años=%2d  pendiente %+9.5f  p = %-9.3g cambio %+6.1f%%\n",
                f, e, nrow(s), co[2,1], co[2,4],
                100*(s$ratio[which.max(s$Yr)]/s$ratio[which.min(s$Yr)] - 1)))
  }
}

cat("\n=== Nivel del ratio: ¿difieren los viajes con y sin buceo? ===\n")
print(as.data.frame(
  tb %>% mutate(grp = ifelse(buceo, "con boquinete", "sin boquinete")) %>%
    group_by(fleet, grp) %>%
    summarise(n_viajes = n(), pct_con_morio = 100*mean(morio),
              ratio = sum(ton_morio)/sum(ton_bonaci), .groups = "drop")),
  digits = 3)

cat("\nLECTURA:\n",
    " - si la tendencia SIN boquinete es igual a la de todos -> el arte no contamina\n",
    " - si difieren y además la contaminación tiene tendencia -> parte del efecto\n",
    "   agregado era mezcla de artes, no abundancia\n",
    " - si el NIVEL del ratio difiere mucho entre estratos -> son selectividades\n",
    "   distintas y no deben mezclarse en ningún caso\n")

dec <- tb %>% filter(!buceo) %>%
  group_by(fleet, Yr) %>%
  summarise(n = n(),
            morio_x_viaje  = sum(ton_morio)/n(),
            bonaci_x_viaje = sum(ton_bonaci)/n(), .groups = "drop")

# revisa ceros ANTES: log(0) = -Inf
print(dec %>% summarise(ceros_morio  = sum(morio_x_viaje  <= 0),
                        ceros_bonaci = sum(bonaci_x_viaje <= 0)))

for (f in unique(dec$fleet)) for (v in c("morio_x_viaje","bonaci_x_viaje")) {
  s  <- dec[dec$fleet == f & dec[[v]] > 0, ]
  m  <- lm(log(s[[v]]) ~ s$Yr, weights = s$n)      # <- log + ponderado por n
  co <- summary(m)$coefficients
  b  <- co[2,1]; span <- diff(range(s$Yr))
  cat(sprintf("%-11s %-16s  %+6.2f%%/año  p=%-9.3g  total %+7.1f%%  (n_años=%d)\n",
              f, v, 100*(exp(b)-1), co[2,4], 100*(exp(b*span)-1), nrow(s)))
}

