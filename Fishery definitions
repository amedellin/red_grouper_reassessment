            t_pul=sum(ton[species %in% PULPO],na.rm=TRUE),
            t_tot=sum(ton,na.rm=TRUE), .groups="drop") %>%
  filter(t_tot>0, t_pul==0) %>%
  group_by(fleet,Yr) %>%
  summarise(share=sum(t_mor)/sum(t_tot), mero=sum(t_mor), .groups="drop")

w <- tidyr::pivot_wider(sh, names_from=fleet, values_from=c(share,mero))
for (L in 0:8) {
  x <- w$mero_artisanal[1:(nrow(w)-L)]      # captura F1 en t
  y <- w$share_mid.range[(1+L):nrow(w)]     # share F2 en t+L
  cat(sprintf("rezago %d años: r = %+.3f  p = %.3g\n", L,
              cor(x,y,use="complete.obs"),
              cor.test(x,y)$p.value))
}

