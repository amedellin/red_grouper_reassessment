library(parallel)

# Función personalizada compatible con Windows
retro_windows <- function(res, nretroyear = 5, ncores = 5) {
  
  # 1. Determinar el número de núcleos a usar (máximo 5 si nretroyear = 5)
  ncores <- min(ncores, nretroyear, detectCores())
  
  # 2. Definir los años/tiempos de corte para la retrospectiva
  max_time <- max(res$inp$timeC)
  maxtimes <- max_time - (1:nretroyear)
  
  # 3. Crear el clúster de procesos en Windows
  cl <- makeCluster(ncores)
  
  # 4. Cargar la librería spict en cada núcleo del clúster
  clusterEvalQ(cl, library(spict))
  
  # 5. Exportar los datos del modelo al clúster
  clusterExport(cl, varlist = c("res", "maxtimes"), envir = environment())
  
  # 6. Ejecutar los ajustes del modelo en paralelo
  message(paste("Ejecutando análisis retrospectivo en", ncores, "núcleos en paralelo..."))
  retro_fits <- parLapply(cl, maxtimes, function(mt) {
    inp_short <- shorten.inp(res$inp, maxtime = mt)
    fit.spict(inp_short)
  })
  
  # 7. Apagar el clúster para liberar la memoria
  stopCluster(cl)
  
  # 8. Asignar los resultados al objeto base de SPiCT
  res$retro <- retro_fits
  return(res)
}

