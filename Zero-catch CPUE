# ============================================================
# 4. Índice delta-lognormal
# ============================================================
DEF <- "B_ensamblaje"          # <- definición principal; repetir con C y D

library(lme4)

idx_fleet <- function(f, use_vessel, min_trips = 20) {
  d <- defs[[DEF]] %>% filter(fleet == f, !buceo) %>%
    mutate(pos = as.integer(ton_mor > 0), Yrf = factor(Yr),
           mesf = factor(mes), Sitef = factor(Site), uef = factor(ue))
  if (use_vessel) {
    keep <- names(which(table(d$uef) >= min_trips))
    d <- d %>% filter(uef %in% keep) %>% mutate(uef = droplevels(uef))
    if (nlevels(d$uef) < 5) return(NULL)
  }
  d  <- d %>% mutate(Yrf = droplevels(Yrf), mesf = droplevels(mesf),
                     Sitef = droplevels(Sitef))
  dp <- d %>% filter(pos == 1) %>% mutate(lc = log(cpue))
  
  if (use_vessel) {
    gb <- glmer(pos ~ Yrf + mesf + Sitef + (1|uef), data = d, family = binomial,
                control = glmerControl(optimizer = "bobyqa"))
    gp <- lmer (lc  ~ Yrf + mesf + Sitef + (1|uef), data = dp, REML = FALSE)
  } else {
    gb <- glm(pos ~ Yrf + mesf + Sitef, data = d,  family = binomial)
    gp <- lm (lc  ~ Yrf + mesf + Sitef, data = dp)
  }
  md <- function(src, v) factor(names(sort(table(src[[v]]), decreasing = TRUE))[1],
                                levels = levels(d[[v]]))
  nd <- data.frame(Yrf = levels(d$Yrf))
  nd$mesf <- md(d, "mesf"); nd$Sitef <- md(d, "Sitef")
  
  pb <- predict(gb, nd, type = "response", re.form = NA)   # efecto aleatorio = 0
  pp <- exp(predict(gp, nd, re.form = NA))
  data.frame(Yr = as.numeric(levels(d$Yrf)), index = (pb*pp)/mean(pb*pp),
             fleet = f, vessel = use_vessel)
}

res <- bind_rows(lapply(unique(tr$fleet), function(f)
  bind_rows(idx_fleet(f, FALSE), tryCatch(idx_fleet(f, TRUE), error = function(e) NULL))))

