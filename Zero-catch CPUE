# -----------------------------------------------------------
# Reconstrucción del índice de abundancia 2000-2023 CON CEROS
# ------------------------------------------------------------
# El índice actual se construyó a partir de registros positivos: un viaje
# que no desembarcó mero simplemente no aparece. Eso lo hace ciego a la
# tasa de encuentro, que cayó de 2.6% a 25.8% de viajes sin mero entre
# 2000 y 2024, y produce hiperestabilidad por construcción.
#
# La definición de "viaje de la pesquería" determina cuántos ceros hay,
# así que se calculan cuatro y se reporta la sensibilidad. Un viaje de
# pulpo NO es un cero; uno que salió al mismo caladero con el mismo arte
# y volvió sin mero, SÍ.
#
# Salida: índice delta-lognormal por flota, con y sin efecto de
# embarcación (solo posible en F2: los avisos artesanales no traen
# RNP.ACTIVO), listo para SS3.
# ============================================================

library(dplyr); library(ggplot2); library(lme4)

MORIO <- "Epinephelus morio"
PULPO <- c("Octopus maya", "Octopus americanus", "Octopus vulgaris")
BUCEO <- c("Lachnolaimus maximus")          # proxy de arte de buceo
DROP  <- c(2002)                            # Isidoro
HOOKS <- c("mid.range" = 500, "artisanal" = 262)   # medianas de permisos

