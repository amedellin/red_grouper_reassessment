idx_fleet <- function(f, use_vessel, min_trips = 20) {
  d <- defs[[DEF]] %>% filter(fleet == f, !buceo, Yr != 2001) %>%
    mutate(pos   = as.integer(ton_mor > 0),
           Sitef = factor(ifelse(Site %in% c("El Cuyo","Rio Lagartos",
                                             "San Felipe","Not specified"),
                                 "other", Site)),
           uef   = factor(if (f == "mid.range") ves else ue),
           Yrf   = factor(Yr), mesf = factor(mes))
  if (use_vessel) {
    keep <- names(which(table(d$uef) >= min_trips))
    d <- d %>% filter(uef %in% keep)
  }
  d  <- d %>% mutate(across(c(Yrf, mesf, Sitef, uef), droplevels))
  dp <- d %>% filter(pos == 1) %>% mutate(lc = log(cpue))
  
  if (use_vessel) {
    gb <- lme4::glmer(pos ~ Yrf + mesf + Sitef + (1|uef), data = d, family = binomial,
                      control = lme4::glmerControl(optimizer = "bobyqa",
                                                   optCtrl = list(maxfun = 2e5)))
    gp <- lme4::lmer(lc ~ Yrf + mesf + Sitef + (1|uef), data = dp, REML = FALSE)
    co <- summary(gp)$coefficients
  } else {
    gb <- glm(pos ~ Yrf + mesf + Sitef, data = d,  family = binomial)
    gp <- lm (lc  ~ Yrf + mesf + Sitef, data = dp)
    co <- summary(gp)$coefficients
  }
  md <- function(v) factor(names(sort(table(d[[v]]), decreasing = TRUE))[1],
                           levels = levels(d[[v]]))
  nd <- data.frame(Yrf = levels(d$Yrf), mesf = md("mesf"), Sitef = md("Sitef"))
  pb <- predict(gb, nd, type = "response", re.form = NA)
  pp <- exp(predict(gp, nd, re.form = NA))
  ix <- pb * pp
  
  se <- co[grep("^Yrf", rownames(co)), 2]        # SE de los efectos de año
  data.frame(Yr = as.numeric(levels(d$Yrf)),
             index  = ix / mean(ix),
             se_log = pmax(0.05, c(mean(se), se)),   # año base: SE promedio
             fleet = f, vessel = use_vessel)
}

