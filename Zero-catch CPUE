                f, v, 100*(exp(coef(m)[2]) - 1), summary(m)$coefficients[2,4]))
  }
  s <- nom %>% filter(fleet == f); m <- lm(log(index) ~ Yr, data = s)
  cat(sprintf("  %-10s NOMINAL con ceros    %+6.2f%%/año  p = %.3g\n",
              f, 100*(exp(coef(m)[2]) - 1), summary(m)$coefficients[2,4]))
  # comparación: solo positivos, como el índice actual
  sp <- defs[["A_solo_positivos"]] %>% filter(fleet == f, !buceo) %>%
    group_by(Yr) %>% summarise(i = mean(cpue), .groups = "drop")
  m2 <- lm(log(i) ~ Yr, data = sp)
  cat(sprintf("  %-10s SOLO POSITIVOS       %+6.2f%%/año  p = %.3g   <- índice actual\n\n",
              f, 100*(exp(coef(m2)[2]) - 1), summary(m2)$coefficients[2,4]))
}

