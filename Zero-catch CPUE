            ton_mor   = sum(ton[species == MORIO], na.rm = TRUE),
            has_mero  = any(species == MORIO),
            has_assoc = any(species %in% sp_assoc),
            has_targ  = any(species.a %in% c("01-target", "02-associated")),
            buceo     = any(species %in% BUCEO),
            pulpo     = any(species %in% PULPO),
            .groups = "drop") %>%
  mutate(nves = ifelse(is.finite(nves) & nves > 0, nves, 1),
         hooks = unname(HOOKS[as.character(fleet)]) * nves,
         cpue  = ton_mor / hooks * 100)

# embarcaciones que participan de verdad (>=20% de sus viajes con mero)
ue_mero <- tr %>% group_by(ue) %>%
  summarise(p = mean(has_mero), n = n(), .groups = "drop") %>%
  filter(p >= 0.20, n >= 10) %>% pull(ue)

